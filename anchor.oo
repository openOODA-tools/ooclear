// # ooclear Root Verification Anchor
//
// Logline: Holistic verification anchor certifying core, render, and ipc subsystems.
//
// Setup: Demands all subsystem anchors to execute comprehensive self-tests.
//
// Beats:
//   1. Assert core terminal profile and sequence resolution subsystem.
//   2. Assert terminal rendering and JSON telemetry subsystem.
//   3. Assert IPC options parser and MCP JSON-RPC protocol subsystem.
//   4. Deliver certified holistic system health.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn verify_all_subsystems() -> Bool {
    if !verify_core_subsystem() {
        return false;
    }
    if !verify_render_subsystem() {
        return false;
    }
    if !verify_ipc_subsystem() {
        return false;
    }
    return true;
}
